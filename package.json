{
  "name": "madiny-tattoo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "images": "node scripts/optimize-images.mjs && node scripts/generate-blur.mjs",
    "build": "next build && npm run sitemap",
    "start": "next start",
    "lint": "eslint app components lib",
    "format": "prettier --write \"{app,components,lib}/**/*.{js,jsx,css}\"",
